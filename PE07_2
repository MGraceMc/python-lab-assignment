class Point:
    def __init__(self, x = 0, y = 0):
        self.x = x
        self.y = y

    # Print the coordinates in (x, y) format
    def __str__(self):
        return "({0}, {1})".format(self.x, self.y)
    
    # Overloading the "+" operator to add two coordinates
    def __add__(self, rhs):
        x = self.x + rhs.x
        y = self.y + rhs.y
        return Point(x, y) 
    
    # Overloading the "-" operator to subtract two coordinates
    def __sub__(self, rhs):
        x = self.x - rhs.x
        y = self.y - rhs.y
        return Point(x, y)
    
    # Overloading the ">" operator to compare two coordinates
    def __gt__(self, rhs):
        return self.x > rhs.x and self.y > rhs.y
    
# Testing the Point class and operator overloading
p1 = Point(13, 15)
p2 = Point(-1, 8)


print(p1)
print(p2)
print(p1 + p2) 

print(p1 - p2) 
print(p1 > p2) 