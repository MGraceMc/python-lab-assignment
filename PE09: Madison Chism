/*Task 1: Return AddressID, City, StateProvince, and CountryRegion. Only include rows where the StateProvnce is Texas and CountryRegion is United States.*/
SELECT 
    AddressID,
	City,
	StateProvince,
	CountryRegion
FROM SalesLT.Address
WHERE StateProvince ='Texas'
  AND CountryRegion = 'United States';

/*Task 2: Only include rows where the StateProvince is Washington, Texas, or Missouri*/
SELECT 
    AddressID,
	City,
	StateProvince,
	CountryRegion
FROM SalesLT.Address
WHERE StateProvince IN ('Washington', 'Texas', 'Missouri')
  AND CountryRegion = 'United States';

/*Task 3: Only include customers whose last name begins with letter A*/
SELECT 
    CustomerID,
	CompanyName,
	FirstName,
	LastName,
	Phone
FROM SalesLT.Customer 
WHERE LastName LIKE 'A%';

/*Task 4: Group by CountryRegion and assign a meaningful name to the COUNT() result*/
/*Corrected*/

SELECT 
   a.CountryRegion, 
   COUNT(*) AS CustomerCount
FROM SalesLT.Customer c 
JOIN SalesLT.CustomerAddress ca 
    ON c.CustomerID = ca.CustomerID
JOIN SalesLT.Address a 
    ON ca.AddressID = a.AddressID
GROUP BY a.CountryRegion;

/*Modified query to sort results by city, query from Task 4 does not so this is the fix to not cause an error:*/
/*Correct Way*/

SELECT 
   a.CountryRegion, 
   a.City,
   COUNT(*) AS CustomerCount
FROM SalesLT.Customer c 
JOIN SalesLT.CustomerAddress ca 
    ON ca.CustomerID = ca.CustomerID
JOIN SalesLT.Address a 
    ON ca.AddressID = a.AddressID
GROUP BY a.CountryRegion, a.City
ORDER BY a.City;


